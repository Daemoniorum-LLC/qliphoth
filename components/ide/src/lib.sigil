// IDE-specific components: tab bar, split view. Shell chrome (command palette,
// status bar, icon tray, panel manager) lives in qliphoth-shell.
//
// Usage:
//   invoke qliphoth·components·ide·types·*;
//   invoke qliphoth·components·ide·tab_bar·{render_tab_bar, TabItem, TabItemMsg};
//   invoke qliphoth·components·ide::split_view·{SplitViewManager, SplitViewMsg};

invoke qliphoth·prelude·*;

☉ scroll types;
☉ scroll tab_bar;
☉ scroll split_view;
