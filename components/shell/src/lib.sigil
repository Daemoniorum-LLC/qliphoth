//
// Application-agnostic shell chrome. Import this package in any Qliphoth app
// that needs a command palette, status bar, icon tray, or panel manager.
//
// Usage:
//   invoke qliphoth·components·shell·types·*;
//   invoke qliphoth·components·shell·command_palette·{CommandPalette, CommandPaletteMsg, category_color};
//   invoke qliphoth·components·shell·status_bar·{StatusBar, StatusBarMsg, StatusBarAction};
//   invoke qliphoth·components·shell·icon_tray·{IconTray, IconTrayMsg};
//   invoke qliphoth·components·shell·panel_manager·{PanelManager, PanelManagerMsg};

invoke qliphoth·prelude·*;

☉ scroll types;
☉ scroll icon_tray;
☉ scroll panel_manager;
☉ scroll command_palette;
☉ scroll status_bar;
